# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Test output
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info

# Packages produced locally (never committed - CI publishes)
*.nupkg
*.snupkg
# A feed inside the checkout is for trying a package before it is published. Restore will not
# find one on its own: NuGet.config clears every source and adds nuget.org alone, deliberately,
# so that an upstream is always the published package. Consuming from a feed here therefore
# means naming it - `dotnet add package ... --source ./local-feed`.
local-feed/
packages/

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Local overrides - never commit machine-specific configuration
*.local.props
*.local.targets

# Private working notes - this repository is public, so they stay out of its history
.conductor/

# What a watch run records. The ledger and its reports are working evidence for whoever
# reads them, not content this repository publishes, so they stay out of its history too.
# The extension is covered repository-wide rather than only under the default path, because
# the path is an argument and a run can be pointed anywhere. Fixtures are put back: a test
# that needs a recorded ledger is source, not evidence.
*.jsonl
sweep-runs/
!tests/**/*.jsonl
