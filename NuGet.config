<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Why <clear />: an adapter's promise is that its upstream is the published, unmodified
       package. Inheriting a machine-local or private feed could satisfy that dependency from
       somewhere else without anyone noticing, so restore resolves from nuget.org only. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Why cleared, and why nothing follows the clear: a mapping decides which of the sources
       above serves which package, and one is inherited from whatever the machine happens to
       have configured. It cannot break the promise made above — a mapping only ever narrows
       the sources already defined, so a hostile one fails the restore loudly instead of
       quietly substituting an upstream — but it does mean a restore that succeeds here can
       fail on a contributor's box for a reason nothing in this repository explains. With the
       inherited mapping cleared and no pattern declared, mapping is off and <packageSources>
       is the whole answer to where a package comes from. -->
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>

</configuration>
